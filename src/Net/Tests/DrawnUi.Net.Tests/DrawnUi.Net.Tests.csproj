<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\DrawnUi\DrawnUi.Net.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- the Hello apps' menu bar page, driven from the keyboard by HelloMenuBarTests -->
        <Compile Include="..\..\..\OpenTk\Samples\HelloOpenTk\Pages\TooltipsMenusPage.cs" Link="Hello\TooltipsMenusPage.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- the 3D add-on's CPU side (reading, posing, animations, hit tests, shapes, controls); the GL renderer stays
             out, Add3d/Renderer3D.Headless.cs draws nothing -->
        <Compile Include="..\..\..\SharedAdd3d\*.cs" Exclude="..\..\..\SharedAdd3d\Renderer3D.cs" LinkBase="SharedAdd3d" />
        <None Include="..\..\..\Blazor\Samples\Add3dGallery\Assets\*.glb" Link="Assets\Add3d\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\green.png" />
        <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
