<Project Sdk="Microsoft.NET.Sdk">

    <!--using Directory.Build.props-->
 
    <ItemGroup>
        <PackageReference Include="BruTile.MbTiles" Version="6.0.0" />
        <PackageReference Include="Mapsui.ArcGIS" Version="5.2.0" />
        <PackageReference Include="Mapsui.Extensions" Version="5.2.0" />
        <PackageReference Include="MapsUi.Maui" Version="5.2.0" />
        <!-- SQLite natives come with BruTile.MbTiles 6 (SourceGear.sqlite3, every platform) -->
        <!-- desktop-only Skia natives: Linux libs must not be packed into Android or iOS apps -->
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="$(DrawnUiSkiaSharpVersion)" Condition="!$(TargetFramework.Contains('-android')) And !$(TargetFramework.Contains('-ios'))" />
    </ItemGroup>
 
    <ItemGroup>
      <ProjectReference Include="..\..\DrawnUi\DrawnUi.Maui.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <Title>MapsUi addon to DrawnUI for .NET MAUI</Title>
        <PackageId>DrawnUi.Maui.MapsUi</PackageId>
        <Description>SkiaMapsUi DrawnUi control for .NET MAUI</Description>
        <PackageTags>maui drawnui skia skiasharp draw maps mapsui</PackageTags>
        <Packable>true</Packable>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <CreatePackage>false</CreatePackage>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <WarningsAsErrors>$(WarningsAsErrors);CS0108</WarningsAsErrors>
    </PropertyGroup>


</Project>