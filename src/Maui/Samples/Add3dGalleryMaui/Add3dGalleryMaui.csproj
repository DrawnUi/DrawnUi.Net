<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <ApplicationId>com.appomobi.add3dgallery</ApplicationId>
        <ApplicationTitle>DrawnUI 3D</ApplicationTitle>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <OutputType>Exe</OutputType>
        <RootNamespace>Add3dGallery</RootNamespace>
        <AssemblyName>Add3dGalleryMaui</AssemblyName>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!--
    No signing settings here: a Debug build for Mac Catalyst needs none, and a Debug build for an iPhone signs with the
    developer identity the Mac has. To sign with your own identity, pass -p:CodesignKey=... -p:CodesignProvision=... on
    the command line, or copy Signing.local.props.example to Signing.local.props next to this file (ignored by git).
    -->
    <Import Project="Signing.local.props" Condition="Exists('Signing.local.props')" />

    <ItemGroup>
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0E1018" />
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0E1018" BaseSize="128,128" />
        <MauiFont Include="Resources\Fonts\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    </ItemGroup>

    <!-- DrawnGame for the gallery pages and the 3D add-on; both bring DrawnUi.Maui with them. -->
    <ItemGroup>
        <ProjectReference Include="..\..\Addons\DrawnUi.Maui.Game\DrawnUi.Maui.Game.csproj" />
        <ProjectReference Include="..\..\Addons\DrawnUi.Maui.Add3d\DrawnUi.Maui.Add3d.csproj" />
    </ItemGroup>

    <!-- The app itself (pages and models), shared with the Blazor and pure WebAssembly samples. -->
    <Import Project="..\..\..\Shared\Samples\Add3dGallery.Shared\Add3dGallery.Shared.projitems" Label="Shared" />

</Project>
