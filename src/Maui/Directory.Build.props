<Project>

    <!--For MAUI-->

    <PropertyGroup>
        <!-- .NET 9 apps stay on the 1.10.9.x packages, the last ones with net9 targets -->
        <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <!-- the .NET 11 targets need the .NET 11 SDK (src/Maui/global.json picks it); an older SDK makes the .NET 10 ones only -->
        <TargetFrameworks Condition="'$(NETCoreSdkVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0;net11.0-android;net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows')) And '$(NETCoreSdkVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <SupportedOSPlatformVersion
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
        <!-- .NET 11 Android needs API 24 at least -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And $(TargetFramework.StartsWith('net11.0'))">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!-- .NET 10 MAUI packages -->
    <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
        <DefineConstants>$(DefineConstants);NET10</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetFramework.StartsWith('net10.0'))">
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.80" />
    </ItemGroup>

    <!-- the packages are packed on the .NET 11 SDK, which makes the .NET 11 targets too -->
    <Target Name="DrawnUiPackNeedsNet11Sdk" BeforeTargets="GenerateNuspec" Condition="!$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">
        <Error Text="Pack $(MSBuildProjectName) with the .NET 11 SDK (run dotnet pack from src\Maui, where global.json selects it): SDK $(NETCoreSdkVersion) makes no net11 targets." />
    </Target>

    <!-- .NET 11 MAUI packages: MAUI 11 has no Compatibility package, DrawnUI does not need it -->
    <PropertyGroup Condition="$(TargetFramework.StartsWith('net11.0'))">
        <DefineConstants>$(DefineConstants);NET11</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetFramework.StartsWith('net11.0'))">
        <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    </ItemGroup>


</Project>