<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Proof of concept: the same app as WpfSandbox, but consuming DrawnUI for WPF as a NuGet
        package instead of a project reference. Nothing from the repo's source is compiled in.
        The version follows the library version in src/Directory.Build.targets; to try an unreleased
        build, pack the library into a local feed first (see README.md).
    -->
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <RootNamespace>WpfPackageDemo</RootNamespace>
        <AssemblyName>WpfPackageDemo</AssemblyName>
        <ApplicationIcon>icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DrawnUi.Wpf" Version="1.10.6.20" />
    </ItemGroup>

</Project>
