<Window x:Class="Add3dGallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:draw="http://schemas.appomobi.com/drawnUi/2023/draw"
        Title="DrawnUI 3D for WPF"
        Icon="icon.ico"
        Width="980" Height="820"
        WindowStartupLocation="CenterScreen"
        Background="#0E1018">

    <!-- 3D draws with the GPU context the canvas uses: Accelerated (ANGLE, GL ES 3 over Direct3D 11). -->
    <draw:DrawnUiElement x:Name="Drawn" RenderingMode="Accelerated" />
</Window>
