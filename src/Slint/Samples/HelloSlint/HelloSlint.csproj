<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- drawnui.slint, for imports, at compile time; at run time the files sit next to each other in the output. -->
    <SlintIncludePaths>$(MSBuildThisFileDirectory)../../DrawnUi</SlintIncludePaths>
  </PropertyGroup>

  <ItemGroup>
    <SlintFile Include="ui/main.slint" />
    <SlintFile Include="../../DrawnUi/drawnui.slint" Generate="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../DrawnUi/DrawnUi.Slint.csproj" />
    <!-- Slint's build files, which generate the classes, reach only direct references. -->
    <PackageReference Include="yurkinh.slint.net" Version="1.19.0-preview.10" />
  </ItemGroup>

</Project>
