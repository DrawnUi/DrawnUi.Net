@page "/skmesh-rocket-probe"
@using DrawnUi.Draw
@using DrawnUi.Views
@using DrawnUi
@using SkiaSharp
@using DrawnUi.Draw.Meshes
@using System.Globalization
@using System.Net.Http
@using Microsoft.AspNetCore.Components.WebAssembly.Http
@using System.Runtime.InteropServices
@inject HttpClient Http

<PageTitle>SKMesh API</PageTitle>

<h1>SKMesh API</h1>

<p id="skmesh-rocket-description"><b>Load "wwwroot/media/rocket.obj", triangulates on the CPU, renders on GPU using SkiaSharp v4 SKMesh.</b></p>

<Canvas Content="_canvasContent"
    WidthRequest="420"
    HeightRequest="560"
    BackgroundColor="@Color.Parse("#060A12")"
    Margin="0,16,0,32"
    RenderingMode="@RenderingModeType.Accelerated"
     />

@code {
    private readonly SkiaLayout _canvasContent;
    private readonly RocketMeshControl _viewer;
    private SkiaLabel _statusLabel = null!;

    public SkMeshRocketProbe()
    {
        _viewer = new RocketMeshControl(SetStatus)
        {
            BackgroundColor = Colors.Blue,
            HorizontalOptions = LayoutOptions.Fill,
            VerticalOptions = LayoutOptions.Fill,
        };

        _canvasContent = new SkiaLayout()
        {
            WidthRequest = 420,
            HeightRequest = 560,
            Padding = new Thickness(20),
            Type = LayoutType.Column,
            Spacing = 14,
            Children =
            {
                new SkiaLabel()
                {
                    Text = "SKMesh loaded OBJ",
                    FontSize = 24,
                    FontAttributes = FontAttributes.Bold,
                    TextColor = Colors.White,
                    HorizontalOptions = LayoutOptions.Fill,
                },
                
                new SkiaLabel()
                {
                    Text = "status: loading",
                    FontSize = 13,
                    TextColor = Color.FromHex("#FFD166"),
                    HorizontalOptions = LayoutOptions.Fill,
                }.Assign(out _statusLabel),

                new SkiaLabel()
                {
                    Text = "Parsed on the CPU; rotation, projection, light and wireframe in the mesh shaders.",
                    FontSize = 13,
                    TextColor = Color.FromHex("#9DB4FF"),
                    HorizontalOptions = LayoutOptions.Fill,
                },

                new SkiaLayer()
                {
                    HorizontalOptions = LayoutOptions.Fill,
                    VerticalOptions = LayoutOptions.Fill,
                    Children =
                    {
                        _viewer,
                        new SkiaLabelFps()
                        {
                            UseCache = SkiaCacheType.GPU,
                            Margin = new (0, 0, 4, 24),
                            VerticalOptions = LayoutOptions.End,
                            HorizontalOptions = LayoutOptions.End,
                            Rotation = -45,
                            BackgroundColor = Colors.DarkRed,
                            TextColor = Colors.White,
                            ZIndex = 110,
                        },
                    }
                },
            }
        };
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, "media/rocket.obj");
            request.SetBrowserRequestCache(BrowserRequestCache.NoStore); // always the file on disk: the dev server keeps the ETag of build time
            using var response = await Http.SendAsync(request);
            response.EnsureSuccessStatusCode();
            var objText = await response.Content.ReadAsStringAsync();
            var model = ObjModel.Parse(objText);
            _viewer.SetModel(model);
            SetStatus($"rocket loaded tris={model.Triangles.Count} verts={model.VertexCount}");
        }
        catch (Exception ex)
        {
            SetStatus("load FAIL: " + ex.Message);
        }
    }

    private void SetStatus(string message)
    {
        Console.WriteLine("[SkMeshRocketProbe] " + message);

        if (_statusLabel != null)
        {
            _statusLabel.Text = message;
            _statusLabel.Update();
        }
    }

    private sealed class RocketMeshControl : SkiaControl
    {
        // Per vertex: position, face normal, triangle center, barycentric corner, the triangle's 3 heights
        // (distance from each corner to its opposite edge). Rotation, projection, light and wireframe run
        // on the GPU; the CPU only sorts the triangles back to front once per frame.
        private const int FloatsPerVertex = 15;
        private const int FloatsPerTriangle = FloatsPerVertex * 3;

        private readonly Action<string> _setStatus;
        private PerpetualPendulumAnimator? _animator;
        private ObjModel? _model;
        private SKMeshSpecification? _spec; // compiled once: SkSL compilation is far too slow for every frame
        private float[] _triangleData = Array.Empty<float>();  // static, FloatsPerTriangle per triangle
        private float[] _centers = Array.Empty<float>();       // static, 3 per triangle
        private SKMeshVertexBuffer? _vertexBuffer;              // made once: the vertices never change
        private ushort[] _indices = Array.Empty<ushort>();     // this frame's draw order, 3 per triangle
        private const int DepthSlots = 4096;
        private float[] _depth = Array.Empty<float>();
        private int[] _slot = Array.Empty<int>();
        private readonly int[] _slotStart = new int[DepthSlots + 1];
        private double _phase;
        private bool _reportedReady;

        public RocketMeshControl(Action<string> setStatus)
        {
            _setStatus = setStatus;
        }

        public void SetModel(ObjModel model)
        {
            var count = model.Triangles.Count;
            var data = new float[count * FloatsPerTriangle];
            var centers = new float[count * 3];
            var o = 0;
            for (var t = 0; t < count; t++)
            {
                var tri = model.Triangles[t];
                var a = tri.A.Position;
                var b = tri.B.Position;
                var c = tri.C.Position;
                var normal = Normalize(Cross(Subtract(b, a), Subtract(c, a)));
                var center = new Vec3((a.X + b.X + c.X) / 3f, (a.Y + b.Y + c.Y) / 3f, (a.Z + b.Z + c.Z) / 3f);
                var doubleArea = Length(Cross(Subtract(b, a), Subtract(c, a)));
                var h0 = doubleArea / Math.Max(1e-6f, Length(Subtract(c, b)));
                var h1 = doubleArea / Math.Max(1e-6f, Length(Subtract(a, c)));
                var h2 = doubleArea / Math.Max(1e-6f, Length(Subtract(b, a)));
                centers[t * 3] = center.X;
                centers[t * 3 + 1] = center.Y;
                centers[t * 3 + 2] = center.Z;
                for (var k = 0; k < 3; k++)
                {
                    var p = k == 0 ? a : k == 1 ? b : c;
                    data[o++] = p.X; data[o++] = p.Y; data[o++] = p.Z;
                    data[o++] = normal.X; data[o++] = normal.Y; data[o++] = normal.Z;
                    data[o++] = center.X; data[o++] = center.Y; data[o++] = center.Z;
                    data[o++] = k == 0 ? 1 : 0; data[o++] = k == 1 ? 1 : 0; data[o++] = k == 2 ? 1 : 0;
                    data[o++] = h0; data[o++] = h1; data[o++] = h2;
                }
            }

            _triangleData = data;
            _centers = centers;
            _vertexBuffer?.Dispose();
            _vertexBuffer = SKMeshVertexBuffer.Make(MemoryMarshal.AsBytes(data.AsSpan()));
            _indices = new ushort[count * 3]; // 16-bit indices: up to 21845 triangles
            _depth = new float[count];
            _slot = new int[count];
            _model = model;
            _reportedReady = false;
            Update();
        }

        protected override void OnLayoutReady()
        {
            base.OnLayoutReady();
            EnsureAnimator();
        }

        public override void OnDisposing()
        {
            _animator?.Stop();
            _animator = null;
            _spec?.Dispose();
            _spec = null;
            _vertexBuffer?.Dispose();
            _vertexBuffer = null;
            base.OnDisposing();
        }

        protected override void Paint(DrawingContext ctx)
        {
            base.Paint(ctx);
            EnsureAnimator();

            var canvas = ctx.Context.Canvas;
            var dest = ctx.Destination;
            if (dest.Width <= 0 || dest.Height <= 0)
            {
                return;
            }

            DrawBackground(canvas, dest);

            if (_model == null || _model.Triangles.Count == 0)
            {
                return;
            }

            try
            {
                string? specErr = null;
                var spec = _spec ??= CreateMeshSpecification(out specErr);
                if (spec == null)
                {
                    _setStatus("rocket spec FAIL: " + specErr);
                    return;
                }

                var phase = (float)_phase;
                var yaw = phase * 0.65f;
                var pitch = -0.35f + MathF.Sin(phase * 0.4f) * 0.12f;
                var roll = MathF.Sin(phase * 0.23f) * 0.08f;

                // The rotation as a matrix: where it sends each axis.
                var rx = Rotate(new Vec3(1, 0, 0), yaw, pitch, roll);
                var ry = Rotate(new Vec3(0, 1, 0), yaw, pitch, roll);
                var rz = Rotate(new Vec3(0, 0, 1), yaw, pitch, roll);

                // No depth buffer: triangles are drawn farthest first, by the depth of their center. A counting sort
                // over DepthSlots depth steps allocates nothing (Array.Sort allocates every call in a Debug build).
                var count = _model.Triangles.Count;
                var minZ = float.MaxValue;
                var maxZ = float.MinValue;
                for (var t = 0; t < count; t++)
                {
                    var z = _centers[t * 3] * rx.Z + _centers[t * 3 + 1] * ry.Z + _centers[t * 3 + 2] * rz.Z;
                    _depth[t] = z;
                    if (z < minZ) minZ = z;
                    if (z > maxZ) maxZ = z;
                }
                var toSlot = (DepthSlots - 1) / Math.Max(1e-6f, maxZ - minZ);
                Array.Clear(_slotStart);
                for (var t = 0; t < count; t++)
                {
                    var slot = (int)((maxZ - _depth[t]) * toSlot); // farthest (largest z) in slot 0
                    _slot[t] = slot;
                    _slotStart[slot + 1]++;
                }
                for (var i = 1; i <= DepthSlots; i++)
                {
                    _slotStart[i] += _slotStart[i - 1];
                }
                for (var t = 0; t < count; t++)
                {
                    var at = _slotStart[_slot[t]]++ * 3;
                    var first = (ushort)(t * 3);
                    _indices[at] = first;
                    _indices[at + 1] = (ushort)(first + 1);
                    _indices[at + 2] = (ushort)(first + 2);
                }

                var bounds = _model.Bounds;
                var uniforms = new float[]
                {
                    rx.X, rx.Y, rx.Z,
                    ry.X, ry.Y, ry.Z,
                    rz.X, rz.Y, rz.Z,
                    dest.MidX, dest.MidY, 540f, 0f,
                    bounds.Min.Z, Math.Max(0.0001f, bounds.Size.Z), 0f, 0f,
                };
                using var uniformData = SKData.CreateCopy(MemoryMarshal.AsBytes(uniforms.AsSpan()));
                using var ib = SKMeshIndexBuffer.Make(MemoryMarshal.AsBytes(_indices.AsSpan()));
                using var mesh = SKMesh.MakeIndexed(
                    spec,
                    SKMeshMode.Triangles,
                    _vertexBuffer!,
                    count * 3,
                    0,
                    ib,
                    count * 3,
                    0,
                    uniformData,
                    dest,
                    out var meshErr);

                if (mesh == null)
                {
                    _setStatus("rocket mesh FAIL: " + meshErr);
                    return;
                }

                using var paint = new SKPaint { IsAntialias = true, Color = SKColors.White };
                canvas.DrawMesh(mesh, paint);

                if (!_reportedReady)
                {
                    _reportedReady = true;
                    _setStatus($"rocket OK tris={count} submitted={count}");
                }
            }
            catch (Exception ex)
            {
                _setStatus("rocket EX: " + ex.GetType().Name + ": " + ex.Message);
            }
        }

        private void EnsureAnimator()
        {
            if (_animator != null)
            {
                return;
            }

            _animator = new PerpetualPendulumAnimator(this, value =>
            {
                _phase = value;
                Update();
            })
            {
                Amplitude = Math.PI,
                Speed = 1.75,
            };
            _animator.Start();
        }

        private static void DrawBackground(SKCanvas canvas, SKRect dest)
        {
            using var fill = new SKPaint
            {
                IsAntialias = true,
                Shader = SKShader.CreateLinearGradient(
                    new SKPoint(dest.Left, dest.Top),
                    new SKPoint(dest.Right, dest.Bottom),
                    new[] { SKColor.Parse("#04070F"), SKColor.Parse("#0A1428") },
                    null,
                    SKShaderTileMode.Clamp),
            };
            canvas.DrawRect(dest, fill);

            using var grid = new SKPaint
            {
                Color = SKColor.Parse("#1C2946"),
                StrokeWidth = 1,
                IsAntialias = true,
                Style = SKPaintStyle.Stroke,
            };

            var cols = 4;
            var rows = 5;
            for (var col = 1; col < cols; col++)
            {
                var x = dest.Left + dest.Width * col / cols;
                canvas.DrawLine(x, dest.Top, x, dest.Bottom, grid);
            }

            for (var row = 1; row < rows; row++)
            {
                var y = dest.Top + dest.Height * row / rows;
                canvas.DrawLine(dest.Left, y, dest.Right, y, grid);
            }

            using var border = new SKPaint
            {
                Color = SKColor.Parse("#2A335C"),
                IsAntialias = true,
                Style = SKPaintStyle.Stroke,
                StrokeWidth = 2,
            };
            canvas.DrawRect(dest, border);
        }

        private static SKMeshSpecification CreateMeshSpecification(out string error)
        {
            var attrs = new[]
            {
                new SKMeshSpecificationAttribute(SKMeshSpecificationAttributeType.Float3, 0, "pos"),
                new SKMeshSpecificationAttribute(SKMeshSpecificationAttributeType.Float3, 12, "normal"),
                new SKMeshSpecificationAttribute(SKMeshSpecificationAttributeType.Float3, 24, "center"),
                new SKMeshSpecificationAttribute(SKMeshSpecificationAttributeType.Float3, 36, "bary"),
                new SKMeshSpecificationAttribute(SKMeshSpecificationAttributeType.Float3, 48, "heights"),
            };
            var varyings = new[]
            {
                new SKMeshSpecificationVarying(SKMeshSpecificationVaryingType.Float4, "color"),
                new SKMeshSpecificationVarying(SKMeshSpecificationVaryingType.Float3, "bary"),
                new SKMeshSpecificationVarying(SKMeshSpecificationVaryingType.Float3, "heights"),
                new SKMeshSpecificationVarying(SKMeshSpecificationVaryingType.Float, "scale"),
            };

            // Rotation, perspective projection and the flat light, per vertex.
            const string vert = @"
                uniform float3 uRotX;
                uniform float3 uRotY;
                uniform float3 uRotZ;
                uniform float4 uView;  // center x, center y, focal
                uniform float4 uDepth; // model min z, model depth
                Varyings main(const Attributes a) {
                    Varyings v;
                    float3 p = a.pos.x * uRotX + a.pos.y * uRotY + a.pos.z * uRotZ;
                    float3 n = a.normal.x * uRotX + a.normal.y * uRotY + a.normal.z * uRotZ;
                    float depth = (a.center.x * uRotX + a.center.y * uRotY + a.center.z * uRotZ).z;
                    float scale = uView.z / max(1.2, 8.5 + p.z);
                    v.position = float2(uView.x + p.x * scale, uView.y - p.y * scale);
                    float lightValue = max(0.16, dot(n, normalize(float3(0.45, -0.6, -1.0))) * 0.75 + 0.25);
                    float t = clamp((depth - uDepth.x) / uDepth.y, 0.0, 1.0);
                    v.color = float4(
                        clamp((0.26 + t * 0.28) * lightValue, 0.0, 1.0),
                        clamp((0.36 + t * 0.22) * lightValue, 0.0, 1.0),
                        clamp((0.45 + t * 0.40) * (0.92 + t * 0.18), 0.0, 1.0),
                        1.0);
                    v.bary = a.bary;
                    v.heights = a.heights;
                    v.scale = scale;
                    return v;
                }";

            // Wireframe: the pixel's distance to the nearest edge of its triangle, in pixels.
            const string frag = @"
                float2 main(const Varyings v, out half4 color) {
                    float3 d = v.bary * v.heights * v.scale;
                    float edge = min(d.x, min(d.y, d.z));
                    float wire = (1.0 - smoothstep(0.0, 1.2, edge)) * 0.43;
                    color = half4(half3(mix(v.color.rgb, float3(0.647, 0.847, 1.0), wire)), 1.0);
                    return v.position;
                }";

            return SKMeshSpecification.Make(
                attrs,
                sizeof(float) * FloatsPerVertex,
                varyings,
                vert,
                frag,
                SKColorSpace.CreateSrgb(),
                SKAlphaType.Premul,
                out error);
        }

        private static Vec3 Rotate(Vec3 point, float yaw, float pitch, float roll)
        {
            var cy = MathF.Cos(yaw);
            var sy = MathF.Sin(yaw);
            var cp = MathF.Cos(pitch);
            var sp = MathF.Sin(pitch);
            var cr = MathF.Cos(roll);
            var sr = MathF.Sin(roll);

            var x1 = point.X * cy - point.Z * sy;
            var z1 = point.X * sy + point.Z * cy;
            var y1 = point.Y;

            var y2 = y1 * cp - z1 * sp;
            var z2 = y1 * sp + z1 * cp;
            var x2 = x1;

            var x3 = x2 * cr - y2 * sr;
            var y3 = x2 * sr + y2 * cr;

            return new Vec3(x3, y3, z2);
        }

        private static Vec3 Subtract(Vec3 a, Vec3 b) => new(a.X - b.X, a.Y - b.Y, a.Z - b.Z);
        private static Vec3 Cross(Vec3 a, Vec3 b) => new(a.Y * b.Z - a.Z * b.Y, a.Z * b.X - a.X * b.Z, a.X * b.Y - a.Y * b.X);
        private static float Length(Vec3 v) => MathF.Sqrt(v.X * v.X + v.Y * v.Y + v.Z * v.Z);

        private static Vec3 Normalize(Vec3 value)
        {
            var length = Length(value);
            if (length <= 0.0001f)
            {
                return new Vec3(0, 1, 0);
            }

            return new Vec3(value.X / length, value.Y / length, value.Z / length);
        }
    }

    private sealed class ObjModel
    {
        public ObjModel(List<Triangle3> triangles, Bounds3 bounds, int vertexCount)
        {
            Triangles = triangles;
            Bounds = bounds;
            VertexCount = vertexCount;
        }

        public List<Triangle3> Triangles { get; }
        public Bounds3 Bounds { get; }
        public int VertexCount { get; }

        public static ObjModel Parse(string source)
        {
            var positions = new List<Vec3>();
            var texcoords = new List<Vec2>();
            var normals = new List<Vec3>();
            var triangles = new List<Triangle3>();
            var min = new Vec3(float.MaxValue, float.MaxValue, float.MaxValue);
            var max = new Vec3(float.MinValue, float.MinValue, float.MinValue);

            foreach (var rawLine in source.Split('\n'))
            {
                var line = rawLine.Trim();
                if (string.IsNullOrWhiteSpace(line) || line.StartsWith("#", StringComparison.Ordinal))
                {
                    continue;
                }

                if (line.StartsWith("v ", StringComparison.Ordinal))
                {
                    var vertex = ParseVec3(line.AsSpan(2));
                    positions.Add(vertex);
                    min = new Vec3(Math.Min(min.X, vertex.X), Math.Min(min.Y, vertex.Y), Math.Min(min.Z, vertex.Z));
                    max = new Vec3(Math.Max(max.X, vertex.X), Math.Max(max.Y, vertex.Y), Math.Max(max.Z, vertex.Z));
                    continue;
                }

                if (line.StartsWith("vt ", StringComparison.Ordinal))
                {
                    texcoords.Add(ParseVec2(line.AsSpan(3)));
                    continue;
                }

                if (line.StartsWith("vn ", StringComparison.Ordinal))
                {
                    normals.Add(ParseVec3(line.AsSpan(3)));
                    continue;
                }

                if (!line.StartsWith("f ", StringComparison.Ordinal))
                {
                    continue;
                }

                var faceTokens = line.AsSpan(2).ToString().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (faceTokens.Length < 3)
                {
                    continue;
                }

                var faceVertices = new FaceVertex[faceTokens.Length];
                for (var index = 0; index < faceTokens.Length; index++)
                {
                    faceVertices[index] = ParseFaceVertex(faceTokens[index], positions, texcoords, normals);
                }

                for (var index = 1; index < faceVertices.Length - 1; index++)
                {
                    triangles.Add(new Triangle3(faceVertices[0], faceVertices[index], faceVertices[index + 1]));
                }
            }

            var center = new Vec3(
                (min.X + max.X) * 0.5f,
                (min.Y + max.Y) * 0.5f,
                (min.Z + max.Z) * 0.5f);
            var size = new Vec3(max.X - min.X, max.Y - min.Y, max.Z - min.Z);
            var maxDim = Math.Max(size.X, Math.Max(size.Y, size.Z));
            var scale = maxDim <= 0.0001f ? 1f : 4.6f / maxDim;

            for (var index = 0; index < triangles.Count; index++)
            {
                triangles[index] = triangles[index].Transform(center, scale);
            }

            return new ObjModel(triangles, new Bounds3(min, max, size), positions.Count);
        }

        private static Vec3 ParseVec3(ReadOnlySpan<char> span)
        {
            var parts = span.ToString().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return new Vec3(ParseFloat(parts[0]), ParseFloat(parts[1]), ParseFloat(parts[2]));
        }

        private static Vec2 ParseVec2(ReadOnlySpan<char> span)
        {
            var parts = span.ToString().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return new Vec2(ParseFloat(parts[0]), ParseFloat(parts[1]));
        }

        private static FaceVertex ParseFaceVertex(string token, List<Vec3> positions, List<Vec2> texcoords, List<Vec3> normals)
        {
            var parts = token.Split('/');
            var position = positions[ParseIndex(parts[0], positions.Count)];
            var texcoord = parts.Length > 1 && parts[1].Length > 0
                ? texcoords[ParseIndex(parts[1], texcoords.Count)]
                : new Vec2(0, 0);
            var normal = parts.Length > 2 && parts[2].Length > 0
                ? normals[ParseIndex(parts[2], normals.Count)]
                : new Vec3(0, 1, 0);

            return new FaceVertex(position, texcoord, normal);
        }

        private static int ParseIndex(string value, int count)
        {
            var parsed = int.Parse(value, NumberStyles.Integer, CultureInfo.InvariantCulture);
            return parsed > 0 ? parsed - 1 : count + parsed;
        }

        private static float ParseFloat(string value)
            => float.Parse(value, NumberStyles.Float, CultureInfo.InvariantCulture);
    }

    private readonly record struct FaceVertex(Vec3 Position, Vec2 Uv, Vec3 Normal)
    {
        public FaceVertex Transform(Vec3 center, float scale)
            => new(
                new Vec3(
                    (Position.X - center.X) * scale,
                    (Position.Y - center.Y) * scale - 0.35f,
                    (Position.Z - center.Z) * scale),
                Uv,
                Normal);
    }

    private readonly record struct Triangle3(FaceVertex A, FaceVertex B, FaceVertex C)
    {
        public Triangle3 Transform(Vec3 center, float scale)
            => new(A.Transform(center, scale), B.Transform(center, scale), C.Transform(center, scale));
    }

    private readonly record struct Bounds3(Vec3 Min, Vec3 Max, Vec3 Size);
    private readonly record struct Vec2(float X, float Y);
    private readonly record struct Vec3(float X, float Y, float Z);
}