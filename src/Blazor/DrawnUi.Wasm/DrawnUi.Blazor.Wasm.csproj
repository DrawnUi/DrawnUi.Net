<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!-- the .NET 11 SDK (packing uses it, see nugets/global.json) adds the .NET 11 target -->
    <TargetFrameworks Condition="'$(NETCoreSdkVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <CreatePackage>false</CreatePackage>
    <PackageId>DrawnUi.Blazor.Wasm</PackageId>
    <Title>DrawnUI for Blazor WebAssembly</Title>
    <Description>Browser and WebAssembly runtime package for DrawnUI Blazor experiences.</Description>
    <PackageTags>drawnui blazor wasm webassembly skia skiasharp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrawnUi\DrawnUi.Blazor.csproj" />
  </ItemGroup>

</Project>
