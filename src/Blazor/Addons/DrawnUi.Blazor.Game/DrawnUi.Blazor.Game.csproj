<Project Sdk="Microsoft.NET.Sdk.Razor">
    <!--using Directory.Build.props-->

    <PropertyGroup>
        <Title>Game creation addon to DrawnUI for Blazor</Title>
        <PackageId>DrawnUi.Blazor.Game</PackageId>
        <Description>Base class for implementing a game with SkiaSharp in Blazor WebAssembly</Description>
        <PackageTags>blazor drawnui skia skiasharp draw game wasm</PackageTags>
        <Packable>true</Packable>
        <CreatePackage>false</CreatePackage>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <!-- the .NET 11 SDK (packing uses it, see nugets/global.json) adds the .NET 11 target -->
        <TargetFrameworks Condition="'$(NETCoreSdkVersion)' != '' And $([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
        <SupportedPlatform Condition="'$(TargetFramework)' == 'net9.0'">browser</SupportedPlatform>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants>$(DefineConstants);BROWSER;</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <WarningsAsErrors>$(WarningsAsErrors);CS0108</WarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\DrawnUi.Wasm\DrawnUi.Blazor.Wasm.csproj" />
    </ItemGroup>

    <Import Project="..\..\..\SharedGame\SharedGame.projitems" Label="Shared" />

</Project>
