<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <!--
        Pure .NET WebAssembly: no Blazor components, no Razor. The BlazorWebAssembly SDK is used only
        for its static-asset hosting; the app boots from wwwroot/main.js into Program.Main.
    -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <!-- index.html's import map gets each script's fingerprinted name: a new deploy never runs an old cached copy -->
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>EmptyCode</RootNamespace>
        <AssemblyName>EmptyCode</AssemblyName>
        <!-- Links native Skia into dotnet.native.wasm; needs the wasm-tools workload. -->
        <WasmBuildNative>true</WasmBuildNative>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <DefineConstants>$(DefineConstants);DRAWNUI_NET;WEB;NET;NET10;BROWSER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DrawnUi.Web" Version="1.11.0.1-pre1" />
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.159.0-rc.1.26567.13" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="15.0.0.100-rc.1.26567.13" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <WasmExtraConfig Include="emcc_flags">
            <Value>-s ERROR_ON_UNDEFINED_SYMBOLS=0 -s ALLOW_MEMORY_GROWTH=1</Value>
        </WasmExtraConfig>
    </ItemGroup>

</Project>
